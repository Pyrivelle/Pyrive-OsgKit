foreach(required DLL IMPLIB CONFIG SOURCE_ROOT PACKAGE_ROOT OSG_ROOT PEREVIA_VERSION)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "PackageSdk missing ${required}")
    endif()
endforeach()
if(CONFIG STREQUAL "Debug")
    set(dependency_bin "${OSG_ROOT}/debug/bin")
    set(suffix d)
else()
    set(dependency_bin "${OSG_ROOT}/bin")
endif()
set(osg_entry_dlls)
foreach(component osgViewer osgGA osgUtil)
    list(APPEND osg_entry_dlls "${dependency_bin}/${component}${suffix}.dll")
endforeach()
set(package_bin "${PACKAGE_ROOT}/bin/${CONFIG}")
set(package_lib "${PACKAGE_ROOT}/lib/${CONFIG}")
file(MAKE_DIRECTORY "${package_bin}" "${package_lib}" "${PACKAGE_ROOT}/include")
file(COPY "${DLL}" DESTINATION "${package_bin}")
file(COPY "${IMPLIB}" DESTINATION "${package_lib}")
if(EXISTS "${PDB}")
    file(COPY "${PDB}" DESTINATION "${package_bin}")
endif()
file(COPY "${SOURCE_ROOT}/include/PereVia" DESTINATION "${PACKAGE_ROOT}/include")
file(COPY "${SOURCE_ROOT}/README.md" "${SOURCE_ROOT}/LICENSE" DESTINATION "${PACKAGE_ROOT}")
file(COPY "${SOURCE_ROOT}/docs" DESTINATION "${PACKAGE_ROOT}")
file(GET_RUNTIME_DEPENDENCIES LIBRARIES "${DLL}" ${osg_entry_dlls}
    DIRECTORIES "${dependency_bin}"
    RESOLVED_DEPENDENCIES_VAR dependencies UNRESOLVED_DEPENDENCIES_VAR missing
    CONFLICTING_DEPENDENCIES_PREFIX conflicts
    PRE_EXCLUDE_REGEXES "[Aa][Pp][Ii]-.*" "[Ee][Xx][Tt]-.*"
    POST_EXCLUDE_REGEXES "[Ss][Yy][Ss][Tt][Ee][Mm]32[/\\]" "[Ss][Yy][Ss][Ww][Oo][Ww]64[/\\]"
)
if(missing)
    message(FATAL_ERROR "Unresolved SDK runtime dependencies: ${missing}")
endif()
foreach(filename IN LISTS conflicts_FILENAMES)
    set(expected_hash "")
    set(selected "")
    foreach(path IN LISTS conflicts_${filename})
        file(SHA256 "${path}" actual_hash)
        if(expected_hash AND NOT actual_hash STREQUAL expected_hash)
            message(FATAL_ERROR "Different binaries found for ${filename}: ${conflicts_${filename}}")
        endif()
        set(expected_hash "${actual_hash}")
        set(selected "${path}")
    endforeach()
    # App-local copies and installed DLLs may be reported at two paths. Accept
    # them only after verifying equal content, then prefer the installed binary.
    if(EXISTS "${dependency_bin}/${filename}")
        set(selected "${dependency_bin}/${filename}")
    endif()
    list(APPEND dependencies "${selected}")
endforeach()
list(APPEND dependencies ${osg_entry_dlls})
list(REMOVE_DUPLICATES dependencies)
get_filename_component(build_bin "${DLL}" DIRECTORY)
foreach(dependency IN LISTS dependencies)
    file(COPY "${dependency}" DESTINATION "${package_bin}")
    file(COPY "${dependency}" DESTINATION "${build_bin}")
endforeach()
file(MAKE_DIRECTORY "${PACKAGE_ROOT}/licenses")
configure_file("${SOURCE_ROOT}/third_party/earcut/LICENSE" "${PACKAGE_ROOT}/licenses/earcut.txt" COPYONLY)
foreach(port osg zlib expat)
    if(EXISTS "${OSG_ROOT}/share/${port}/copyright")
        configure_file("${OSG_ROOT}/share/${port}/copyright" "${PACKAGE_ROOT}/licenses/${port}.txt" COPYONLY)
    endif()
endforeach()
get_filename_component(dll_name "${DLL}" NAME)
get_filename_component(lib_name "${IMPLIB}" NAME)
string(TOUPPER "${CONFIG}" config_upper)
string(TOLOWER "${CONFIG}" config_lower)
set(cmake_dir "${PACKAGE_ROOT}/lib/cmake/PereViaOsg")
file(MAKE_DIRECTORY "${cmake_dir}")
configure_file("${SOURCE_ROOT}/cmake/PereViaOsgConfig.cmake" "${cmake_dir}/PereViaOsgConfig.cmake" COPYONLY)
configure_file("${SOURCE_ROOT}/cmake/OsgDependency.cmake" "${cmake_dir}/OsgDependency.cmake" COPYONLY)
file(WRITE "${cmake_dir}/PereViaOsg-${config_lower}.cmake"
    "set_property(TARGET Pyrive::OsgKit APPEND PROPERTY IMPORTED_CONFIGURATIONS ${config_upper})\n"
    "set_target_properties(Pyrive::OsgKit PROPERTIES\n"
    "  IMPORTED_LOCATION_${config_upper} \"\${_perevia_prefix}/bin/${CONFIG}/${dll_name}\"\n"
    "  IMPORTED_IMPLIB_${config_upper} \"\${_perevia_prefix}/lib/${CONFIG}/${lib_name}\")\n")
file(WRITE "${PACKAGE_ROOT}/manifest-${CONFIG}.txt"
    "PereVia OSG ${PEREVIA_VERSION}\nConfiguration: ${CONFIG}\nArchitecture: x64\nMSVC: ${COMPILER_VERSION}\n"
    "C++: 17\nOSG: 3.6.5 (GL2)\nCRT: shared /MD or /MDd matching configuration\n")
message(STATUS "PereVia OSG ${CONFIG} SDK packaged at ${PACKAGE_ROOT}")
